<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid Condition="'$(ProjectGuid)' == ''">{1451D687-A040-4E36-81E4-5D6229B769BB}</ProjectGuid>
    <RootNamespace>window_sweaters.startup</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>WindowSweaters.Startup</TargetName>
    <StartupRuntimeLibrary Condition="'$(StartupRuntimeLibrary)'=='' and '$(Configuration)'=='Debug'">MultiThreadedDebug</StartupRuntimeLibrary>
    <StartupRuntimeLibrary Condition="'$(StartupRuntimeLibrary)'==''">MultiThreaded</StartupRuntimeLibrary>
    <OutDir>$(OutDir)Startup\$(StartupRuntimeLibrary)\</OutDir>
    <IntDir>$(IntDir)$(StartupRuntimeLibrary)\</IntDir>
    <StartupCppWinRTDir Condition="'$(StartupCppWinRTDir)'=='' and Exists('$(MSBuildThisFileDirectory).packages\Microsoft.Windows.CppWinRT.2.0.240405.15\bin\cppwinrt.exe')">$(MSBuildThisFileDirectory).packages\Microsoft.Windows.CppWinRT.2.0.240405.15\</StartupCppWinRTDir>
    <StartupCppWinRTDir Condition="'$(StartupCppWinRTDir)'=='' and Exists('$(MSBuildThisFileDirectory)..\Settings\.packages\Microsoft.Windows.CppWinRT.2.0.240405.15\bin\cppwinrt.exe')">$(MSBuildThisFileDirectory)..\Settings\.packages\Microsoft.Windows.CppWinRT.2.0.240405.15\</StartupCppWinRTDir>
    <StartupCppWinRTDir Condition="'$(StartupCppWinRTDir)'==''">$(UserProfile)\.nuget\packages\microsoft.windows.cppwinrt\2.0.240405.15\</StartupCppWinRTDir>
    <StartupProjectionDir>$(IntDir)StartupProjection\</StartupProjectionDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalIncludeDirectories>$(StartupProjectionDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;WINRT_NO_SOURCE_LOCATION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'!='Debug'">MultiThreaded</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(StartupRuntimeLibrary)'!=''">$(StartupRuntimeLibrary)</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'!='Debug'">MaxSpeed</Optimization>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Startup.cpp" />
    <ClCompile Include="NativeStartup.cpp" />
    <ClInclude Include="Startup.h" />
    <None Include="README.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="GenerateStartupProjection" BeforeTargets="ClCompile"
          Inputs="$(StartupCppWinRTDir)bin\cppwinrt.exe;$(WindowsSdkDir)UnionMetadata\$(WindowsTargetPlatformVersion)\Windows.winmd"
          Outputs="$(StartupProjectionDir)winrt\Windows.ApplicationModel.h;$(StartupProjectionDir)winrt\base.h">
    <Error Condition="!Exists('$(StartupCppWinRTDir)bin\cppwinrt.exe')" Text="Restore Microsoft.Windows.CppWinRT 2.0.240405.15 under src\Startup\.packages or set StartupCppWinRTDir to that exact package." />
    <MakeDir Directories="$(StartupProjectionDir)" />
    <Exec Command="&quot;$(StartupCppWinRTDir)bin\cppwinrt.exe&quot; -input &quot;$(WindowsSdkDir)UnionMetadata\$(WindowsTargetPlatformVersion)\Windows.winmd&quot; -include Windows.ApplicationModel.StartupTask -include Windows.Foundation -base -output &quot;$(StartupProjectionDir).&quot;" />
  </Target>
</Project>
