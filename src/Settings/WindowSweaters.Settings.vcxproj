          Outputs="$(OutDir)resources.pri">
    <Error Condition="!Exists('$(SettingsMakePriExe)')" Text="Windows SDK MakePRI is required to index native WinUI application resources: $(SettingsMakePriExe)"/>
    <ItemGroup>
      <SettingsFrameworkPri Include="$(OutDir)Microsoft.UI.pri;$(OutDir)Microsoft.UI.Xaml.Controls.pri;$(OutDir)Microsoft.WindowsAppRuntime.pri"/>
    </ItemGroup>
    <Error Condition="!Exists('%(SettingsFrameworkPri.Identity)')" Text="Missing self-contained native resource payload: %(SettingsFrameworkPri.Identity)"/>
    <MakeDir Directories="$(SettingsPriStage)"/>
    <Copy SourceFiles="@(SettingsFrameworkPri)" DestinationFolder="$(SettingsPriStage)" SkipUnchangedFiles="true"/>
    <!-- Only compiled PRI inputs are scanned. Including loose framework assets
         here would index duplicate NoiseAsset/map paths from the same package. -->
    <Exec Command="&quot;$(SettingsMakePriExe)&quot; new /pr &quot;$(SettingsPriStage).&quot; /cf &quot;$(MSBuildThisFileDirectory)priconfig.xml&quot; /in &quot;$(TargetName)&quot; /of &quot;$(OutDir)resources.pri&quot; /o"/>
    <ItemGroup><FileWrites Include="$(OutDir)resources.pri;@(SettingsFrameworkPri->'$(SettingsPriStage)%(Filename)%(Extension)')"/></ItemGroup>
  </Target>
